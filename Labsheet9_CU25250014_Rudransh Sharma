def solve():
    N = int(input())

    A = []
    for _ in range(N):
        A.append(int(input()))

    for i in range(1, N):
        if A[i] != A[0]:
            return -1

    # Number of operations needed to make them 0
    return abs(A[0])


T = int(input())

for _ in range(T):
    print(solve())
