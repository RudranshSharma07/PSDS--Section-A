def maximize_difference(arr):
    arr.sort()

    n = len(arr)
    result = []

    left = 0
    right = n - 1

    while left <= right:
        result.append(arr[left])
        left += 1

        if left <= right:
            result.append(arr[right])
            right -= 1

    total = 0

    for i in range(1, n):
        total += abs(result[i] - result[i - 1])

    return result, total


arr = [4, 2, 7, 1]
result, total = maximize_difference(arr)

print("Rearranged Array:", result)
print("Maximum Sum:", total)


