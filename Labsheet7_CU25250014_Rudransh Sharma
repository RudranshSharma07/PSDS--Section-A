class Heap:
    def __init__(self, is_min=True):
        self.heap = []
        self.is_min = is_min

    def compare(self, a, b):
        if self.is_min:
            return a < b
        return a > b

    def insert(self, value):
        self.heap.append(value)
        i = len(self.heap) - 1

        while i > 0:
            parent = (i - 1) // 2

            if not self.compare(self.heap[i], self.heap[parent]):
                break

            self.heap[i], self.heap[parent] = (
                self.heap[parent], self.heap[i]
            )
            i = parent

    def delete(self):
        if not self.heap:
            return None

        result = self.heap[0]
        last = self.heap.pop()

        if self.heap:
            self.heap[0] = last
            self.heapify(0)

        return result

    def heapify(self, i):
        n = len(self.heap)

        while True:
            left = 2 * i + 1
            right = 2 * i + 2
            best = i

            if (left < n and
                self.compare(self.heap[left], self.heap[best])):
                best = left

            if (right < n and
                self.compare(self.heap[right], self.heap[best])):
                best = right

            if best == i:
                break

            self.heap[i], self.heap[best] = (
                self.heap[best], self.heap[i]
            )
            i = best

    def display(self):
        print(self.heap)

min_heap = Heap(is_min=True)

max_heap = Heap(is_min=False)

