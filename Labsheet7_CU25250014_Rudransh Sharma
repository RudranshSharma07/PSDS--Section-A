def smallest_subarray(arr, target):
    n = len(arr)

    left = 0
    current_sum = 0
    min_length = n + 1

    for right in range(n):
        current_sum += arr[right]

        while current_sum > target:
            length = right - left + 1
            min_length = min(min_length, length)

            current_sum -= arr[left]
            left += 1

    if min_length == n + 1:
        return -1

    return min_length


arr = [2, 1, 5, 2, 3, 2]
target = 7

print("Smallest Subarray Length:",
      smallest_subarray(arr, target))
